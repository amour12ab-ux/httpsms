<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Settings"
            app:navigationIcon="@drawable/ic_arrow_back"
            android:background="@color/colorPrimary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Server Connection ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="SERVER CONNECTION"
                        android:textSize="11sp" android:textColor="@color/colorPrimary"
                        android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Server URL" app:helperText="e.g. http://192.168.1.10:3000"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerUrl" android:inputType="textUri"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="API Key" android:layout_marginTop="12dp"
                        app:passwordToggleEnabled="true"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKey" android:inputType="textPassword"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection" android:text="Test Connection"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvConnectionResult"
                            android:textSize="13sp" android:visibility="gone"
                            android:layout_marginStart="8dp"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Phone Numbers ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="PHONE NUMBERS"
                        android:textSize="11sp" android:textColor="@color/colorPrimary"
                        android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:text="Each number registers as a separate device. Tap a number to set it as active."
                        android:textSize="13sp" android:textColor="@color/colorTextSecondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"/>

                    <!-- Existing profiles list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPhoneProfiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <TextView android:id="@+id/tvNoProfiles"
                        android:text="No phone numbers added yet"
                        android:textSize="13sp" android:textColor="@color/colorTextHint"
                        android:gravity="center" android:visibility="gone"
                        android:padding="12dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/colorDivider" android:layout_marginVertical="12dp"/>

                    <!-- Add new profile -->
                    <TextView android:text="Add phone number"
                        android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Label (e.g. Work SIM)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProfileLabel" android:inputType="text"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Phone Number (e.g. +1234567890)"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProfilePhone" android:inputType="phone"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddProfile"
                        android:text="Add &amp; Register"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconGravity="textStart"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── API Keys ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:text="API KEYS"
                        android:textSize="11sp" android:textColor="@color/colorPrimary"
                        android:textStyle="bold" android:letterSpacing="0.1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>

                    <TextView android:text="Generate keys to connect external systems to this gateway."
                        android:textSize="13sp" android:textColor="@color/colorTextSecondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="Key label"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etKeyLabel" android:inputType="text"
                                android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenerateKey" android:text="Generate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:icon="@android:drawable/ic_menu_add"/>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNewKey"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:visibility="gone"
                        app:cardBackgroundColor="@color/colorSuccessBg"
                        app:cardElevation="0dp" app:cardCornerRadius="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="12dp">
                            <TextView android:text="Copy this key now — it won't be shown again"
                                android:textSize="12sp" android:textColor="@color/colorSuccess"
                                android:textStyle="bold"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:id="@+id/tvNewKey"
                                    android:textSize="13sp" android:textColor="@color/colorTextPrimary"
                                    android:fontFamily="monospace"
                                    android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:ellipsize="middle" android:maxLines="1"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopyKey" android:text="Copy"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:id="@+id/tvNoKeys" android:text="No keys yet"
                        android:textSize="13sp" android:textColor="@color/colorTextHint"
                        android:gravity="center" android:visibility="gone"
                        android:padding="16dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvApiKeys"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:nestedScrollingEnabled="false"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings" android:text="Save Settings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:icon="@android:drawable/ic_menu_save"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
